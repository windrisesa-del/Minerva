# Local development only. The bundled launcher binds PostgreSQL and FastAPI to 127.0.0.1.
DATABASE_URL=postgresql+psycopg://minerva@127.0.0.1:5432/minerva
MINERVA_API_HOST=127.0.0.1
MINERVA_API_PORT=8000
WIKIJS_URL=http://127.0.0.1:3002
WIKIJS_PUBLIC_URL=http://127.0.0.1:3002
WIKIJS_LOCALE=zh
# Create a read-only API key in Wiki.js Administration > API Access.
WIKIJS_API_TOKEN=
