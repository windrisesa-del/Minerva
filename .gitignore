# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!backend/.env.example

# Project-local plugin install tree
.pi/npm/

# Local agent notes and QA captures
/task_plan.md
/findings.md
/progress.md
/artifacts/
/audit-evidence/

# Nested Pi Core git metadata parked while vendoring
/vendor/pi-core/.git.bak-nested/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
e2e_*.mjs

# FastAPI / local PostgreSQL runtime
/backend/.venv/
/backend/.uv-cache/
/backend/.runtime/
/backend/.data/
/backend/*.log
__pycache__/
*.py[cod]
.pytest_cache/
